{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User configuration like hourly rate and employer name",
      "type": "object",
      "properties": {
        "hourlyRate": { "type": "number", "description": "The user's default hourly rate" },
        "employerName": { "type": "string", "description": "The user's default employer/client name" }
      },
      "required": ["hourlyRate", "employerName"]
    },
    "WorkEntry": {
      "title": "Work Entry",
      "description": "A tracked work session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The ID of the entry" },
        "date": { "type": "string", "description": "ISO date string of when the work was done or logged" },
        "task": { "type": "string", "description": "Description of the task" },
        "durationMs": { "type": "number", "description": "Duration of the task in milliseconds" },
        "earned": { "type": "number", "description": "Amount earned during this task" },
        "userId": { "type": "string", "description": "The ID of the user who owns this entry" },
        "employer": { "type": "string", "description": "The employer for this entry" }
      },
      "required": ["id", "date", "task", "durationMs", "earned", "userId"]
    },
    "InvoiceHistory": {
      "title": "Invoice History",
      "description": "Record of a generated invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The ID of the invoice" },
        "generatedAt": { "type": "string", "description": "ISO date string of when it was generated" },
        "periodStr": { "type": "string", "description": "The period of the invoice" },
        "employer": { "type": "string", "description": "Employer or client name" },
        "totalAmount": { "type": "number", "description": "Total amount billed" },
        "userId": { "type": "string", "description": "The ID of the user who generated this invoice" }
      },
      "required": ["id", "generatedAt", "periodStr", "employer", "totalAmount", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user configuration"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": { "$ref": "#/entities/WorkEntry" },
      "description": "Stores individual work entries per user"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/InvoiceHistory" },
      "description": "Stores generated invoices history per user"
    }
  }
}
